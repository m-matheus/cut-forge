# === Anthropic (script + lyrics generation) ===
ANTHROPIC_API_KEY=sk-ant-...
# Optional model overrides
# ANTHROPIC_MODEL=claude-sonnet-5

# === OpenAI (thumbnail via Responses API + Whisper lyric alignment) ===
OPENAI_API_KEY=sk-...

# === ElevenLabs (optional TTS — music videos usually skip this) ===
ELEVENLABS_API_KEY=...
# VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=eleven_v3

# === YouTube (footage + reference download) ===
# Netscape-format cookies exported from a browser logged into YouTube, e.g. with the
# "Get cookies.txt LOCALLY" extension. Required; re-export every few weeks when YouTube
# starts asking to "confirm you're not a bot".
YOUTUBE_COOKIES_FILE=C:/path/to/www.youtube.com_cookies.txt
# Footage quality. "edit" (default) = best H.264 rendition, imports into Premiere with no
# re-encode, caps at 1080p on most uploads. "max" = highest resolution at any codec
# (1440p/2160p VP9 or AV1), transcoded to H.264 afterwards.
# YOUTUBE_QUALITY=edit
# Optional resolution ceiling, e.g. 1080 or 1440. Unset = no cap.
# YOUTUBE_MAX_HEIGHT=

# === General ===
# OUTPUT_BASE_DIR=output
